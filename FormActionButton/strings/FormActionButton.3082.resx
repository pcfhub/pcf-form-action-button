  <data name="FormActionButton_Name" xml:space="preserve">
    <value>Botón de acción de formulario</value>
  </data>
  <data name="FormActionButton_Desc" xml:space="preserve">
    <value>Un botón para formularios basados en modelos que genera un evento que un script de formulario puede gestionar, confirmar y responder.</value>
  </data>
  <data name="signal_Name" xml:space="preserve">
    <value>Columna de señal</value>
  </data>
  <data name="signal_Desc" xml:space="preserve">
    <value>La columna en la que se coloca el botón. No se escribe salvo que Escribir en la columna de señal esté activado.</value>
  </data>
  <data name="label_Name" xml:space="preserve">
    <value>Etiqueta</value>
  </data>
  <data name="label_Desc" xml:space="preserve">
    <value>El texto del botón, que es también su nombre accesible.</value>
  </data>
  <data name="icon_Name" xml:space="preserve">
    <value>Icono</value>
  </data>
  <data name="icon_Desc" xml:space="preserve">
    <value>Un glifo opcional que se muestra antes de la etiqueta.</value>
  </data>
  <data name="icon_None" xml:space="preserve">
    <value>Ninguno</value>
  </data>
  <data name="icon_Send" xml:space="preserve">
    <value>Enviar</value>
  </data>
  <data name="icon_Delete" xml:space="preserve">
    <value>Eliminar</value>
  </data>
  <data name="confirmRequired_Name" xml:space="preserve">
    <value>Confirmar antes de actuar</value>
  </data>
  <data name="confirmRequired_Desc" xml:space="preserve">
    <value>Pide confirmación al usuario antes de generar el evento.</value>
  </data>
  <data name="confirmTitle_Name" xml:space="preserve">
    <value>Título de la confirmación</value>
  </data>
  <data name="confirmTitle_Desc" xml:space="preserve">
    <value>El título del cuadro de diálogo de confirmación. Déjalo vacío para usar el predeterminado.</value>
  </data>
  <data name="confirmText_Name" xml:space="preserve">
    <value>Mensaje de confirmación</value>
  </data>
  <data name="confirmText_Desc" xml:space="preserve">
    <value>La pregunta que plantea el cuadro de diálogo. Déjalo vacío para usar el predeterminado.</value>
  </data>
  <data name="confirmButtonLabel_Name" xml:space="preserve">
    <value>Botón de confirmación</value>
  </data>
  <data name="confirmButtonLabel_Desc" xml:space="preserve">
    <value>La palabra afirmativa. Se usa en el diálogo y como texto del botón mientras hay una confirmación en línea activa.</value>
  </data>
  <data name="writeSignal_Name" xml:space="preserve">
    <value>Escribir en la columna de señal</value>
  </data>
  <data name="writeSignal_Desc" xml:space="preserve">
    <value>Escribe cada pulsación en la columna enlazada, para que su controlador OnChange y las reglas de negocio la vean.</value>
  </data>
  <data name="requirePrivilege_Name" xml:space="preserve">
    <value>Exigir un privilegio</value>
  </data>
  <data name="requirePrivilege_Desc" xml:space="preserve">
    <value>Comprueba el privilegio del usuario sobre esta tabla antes de permitir pulsar el botón.</value>
  </data>
  <data name="privilege_None" xml:space="preserve">
    <value>Sin comprobación</value>
  </data>
  <data name="privilege_Create" xml:space="preserve">
    <value>Crear</value>
  </data>
  <data name="privilege_Read" xml:space="preserve">
    <value>Leer</value>
  </data>
  <data name="privilege_Write" xml:space="preserve">
    <value>Escribir</value>
  </data>
  <data name="privilege_Delete" xml:space="preserve">
    <value>Eliminar</value>
  </data>
  <data name="privilege_Append" xml:space="preserve">
    <value>Anexar</value>
  </data>
  <data name="privilege_AppendTo" xml:space="preserve">
    <value>Anexar a</value>
  </data>
  <data name="privilegeDenied_Name" xml:space="preserve">
