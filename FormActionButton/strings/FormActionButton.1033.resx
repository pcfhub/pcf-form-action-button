<?xml version="1.0" encoding="utf-8"?>
<root>
  <!--
    Display names and descriptions for everything declared in
    ControlManifest.Input.xml. PCFHub reads the manifest, so these strings are
    what appear in the component's API reference on the hub as well as in the
    maker's properties pane.

    Copy this file to add a language — FormActionButton.3082.resx for Spanish, and so
    on — then list it under <resources> in the manifest.
  -->
  <xsd:schema id="root" xmlns="" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
    <xsd:import namespace="http://www.w3.org/XML/1998/namespace" />
    <xsd:element name="root" msdata:IsDataSet="true">
      <xsd:complexType>
        <xsd:choice maxOccurs="unbounded">
          <xsd:element name="metadata">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" />
              </xsd:sequence>
              <xsd:attribute name="name" use="required" type="xsd:string" />
              <xsd:attribute name="type" type="xsd:string" />
              <xsd:attribute name="mimetype" type="xsd:string" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="assembly">
            <xsd:complexType>
              <xsd:attribute name="alias" type="xsd:string" />
              <xsd:attribute name="name" type="xsd:string" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="data">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
                <xsd:element name="comment" type="xsd:string" minOccurs="0" msdata:Ordinal="2" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" msdata:Ordinal="1" />
              <xsd:attribute name="type" type="xsd:string" msdata:Ordinal="3" />
              <xsd:attribute name="mimetype" type="xsd:string" msdata:Ordinal="4" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="resheader">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" />
            </xsd:complexType>
          </xsd:element>
        </xsd:choice>
      </xsd:complexType>
    </xsd:element>
  </xsd:schema>
  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>

  <data name="FormActionButton_Name" xml:space="preserve">
    <value>Form Action Button</value>
  </data>
  <data name="FormActionButton_Desc" xml:space="preserve">
    <value>A model-driven form button that raises an event a form script can handle, confirm and answer.</value>
  </data>
  <data name="signal_Name" xml:space="preserve">
    <value>Signal column</value>
  </data>
  <data name="signal_Desc" xml:space="preserve">
    <value>The column the button sits on. Not written unless Write to the signal column is on.</value>
  </data>
  <data name="label_Name" xml:space="preserve">
    <value>Label</value>
  </data>
  <data name="label_Desc" xml:space="preserve">
    <value>The text on the button, which is also its accessible name.</value>
  </data>
  <data name="icon_Name" xml:space="preserve">
    <value>Icon</value>
  </data>
  <data name="icon_Desc" xml:space="preserve">
    <value>An optional glyph shown before the label.</value>
  </data>
  <data name="icon_None" xml:space="preserve">
    <value>None</value>
  </data>
  <data name="icon_Send" xml:space="preserve">
    <value>Send</value>
  </data>
  <data name="icon_Delete" xml:space="preserve">
    <value>Delete</value>
  </data>
  <data name="confirmRequired_Name" xml:space="preserve">
    <value>Confirm before acting</value>
  </data>
  <data name="confirmRequired_Desc" xml:space="preserve">
    <value>Ask the user to confirm before the event is raised.</value>
  </data>
  <data name="confirmTitle_Name" xml:space="preserve">
    <value>Confirmation title</value>
  </data>
  <data name="confirmTitle_Desc" xml:space="preserve">
    <value>The title of the confirmation dialog. Leave empty for a default.</value>
  </data>
  <data name="confirmText_Name" xml:space="preserve">
    <value>Confirmation message</value>
  </data>
  <data name="confirmText_Desc" xml:space="preserve">
    <value>The question the confirmation dialog asks. Leave empty for a default.</value>
  </data>
  <data name="confirmButtonLabel_Name" xml:space="preserve">
    <value>Confirmation button</value>
  </data>
  <data name="confirmButtonLabel_Desc" xml:space="preserve">
    <value>The affirmative word. Used in the dialog, and as the button’s caption while an inline confirmation is armed.</value>
  </data>
  <data name="writeSignal_Name" xml:space="preserve">
    <value>Write to the signal column</value>
  </data>
  <data name="writeSignal_Desc" xml:space="preserve">
    <value>Write each press into the bound column, so its own OnChange handler and business rules see it.</value>
  </data>
  <data name="requirePrivilege_Name" xml:space="preserve">
    <value>Require a privilege</value>
  </data>
  <data name="requirePrivilege_Desc" xml:space="preserve">
    <value>Check the user’s privilege on this table before letting the button be pressed.</value>
  </data>
  <data name="privilege_None" xml:space="preserve">
    <value>No check</value>
  </data>
  <data name="privilege_Create" xml:space="preserve">
    <value>Create</value>
  </data>
  <data name="privilege_Read" xml:space="preserve">
    <value>Read</value>
  </data>
  <data name="privilege_Write" xml:space="preserve">
    <value>Write</value>
  </data>
  <data name="privilege_Delete" xml:space="preserve">
    <value>Delete</value>
  </data>
  <data name="privilege_Append" xml:space="preserve">
    <value>Append</value>
  </data>
  <data name="privilege_AppendTo" xml:space="preserve">
    <value>Append to</value>
  </data>
  <data name="privilegeDenied_Name" xml:space="preserve">
    <value>When the privilege is missing</value>
  </data>
  <data name="privilegeDenied_Desc" xml:space="preserve">
    <value>Whether to disable the button or hide it entirely.</value>
  </data>
  <data name="denied_Disable" xml:space="preserve">
    <value>Disable it</value>
  </data>
  <data name="denied_Hide" xml:space="preserve">
    <value>Hide it</value>
  </data>
  <data name="pressCount_Name" xml:space="preserve">
    <value>Press count</value>
  </data>
  <data name="pressCount_Desc" xml:space="preserve">
    <value>How many times the button has raised its event. Increments on every raise, so a repeat is observable.</value>
  </data>
  <data name="lastAction_Name" xml:space="preserve">
    <value>Last action</value>
  </data>
  <data name="lastAction_Desc" xml:space="preserve">
    <value>Either "press" or "confirm", depending on whether the press was confirmed.</value>
  </data>
  <data name="onAction_Name" xml:space="preserve">
    <value>On action</value>
  </data>
  <data name="onAction_Desc" xml:space="preserve">
    <value>Raised when the button is pressed and any confirmation has been given. A form script binds to it with addEventHandler("onAction", fn).</value>
  </data>
  <data name="FormActionButton_DefaultLabel" xml:space="preserve">
    <value>Submit</value>
  </data>
  <data name="FormActionButton_ConfirmTitle" xml:space="preserve">
    <value>Confirm</value>
  </data>
  <data name="FormActionButton_ConfirmText" xml:space="preserve">
    <value>Are you sure?</value>
  </data>
  <data name="FormActionButton_ConfirmButton" xml:space="preserve">
    <value>Confirm</value>
  </data>
  <data name="FormActionButton_Armed" xml:space="preserve">
    <value>Press again to confirm, or press Escape to cancel.</value>
  </data>
  <data name="FormActionButton_Cancelled" xml:space="preserve">
    <value>Cancelled.</value>
  </data>
  <data name="FormActionButton_TimedOut" xml:space="preserve">
    <value>The confirmation expired.</value>
  </data>
  <data name="FormActionButton_Busy" xml:space="preserve">
    <value>Working…</value>
  </data>
  <data name="FormActionButton_Done" xml:space="preserve">
    <value>Done.</value>
  </data>
  <data name="FormActionButton_Failed" xml:space="preserve">
    <value>The action did not complete.</value>
  </data>
  <data name="FormActionButton_Stalled" xml:space="preserve">
    <value>The action never reported back, so the button was released.</value>
  </data>
  <data name="FormActionButton_NoPrivilege" xml:space="preserve">
    <value>You do not have permission to do this.</value>
  </data>
  <data name="actionName_Name" xml:space="preserve">
    <value>Action name</value>
  </data>
  <data name="actionName_Desc" xml:space="preserve">
    <value>The unique name of a Dataverse action — your Custom API or a platform message — to call on every press that commits. Case-sensitive. Leave it empty for a button that only raises its event.</value>
  </data>
  <data name="actionBinding_Name" xml:space="preserve">
    <value>Action binding</value>
  </data>
  <data name="actionBinding_Desc" xml:space="preserve">
    <value>Bound: called on the record this form shows. Unbound: called on its own.</value>
  </data>
  <data name="binding_Bound" xml:space="preserve">
    <value>Bound to this record</value>
  </data>
  <data name="binding_Unbound" xml:space="preserve">
    <value>Unbound</value>
  </data>
  <data name="actionParameters_Name" xml:space="preserve">
    <value>Action parameters</value>
  </data>
  <data name="actionParameters_Desc" xml:space="preserve">
    <value>The parameters as JSON, or the name of a web resource holding them (a form keeps 100 characters here). {id} puts the record's id into any text; a value of exactly "{record}" sends the record as a reference.</value>
  </data>
  <data name="resultProperty_Name" xml:space="preserve">
    <value>Result property</value>
  </data>
  <data name="resultProperty_Desc" xml:space="preserve">
    <value>A response property of the action whose value the button says after the call.</value>
  </data>
  <data name="actionStatus_Name" xml:space="preserve">
    <value>Action status</value>
  </data>
  <data name="actionStatus_Desc" xml:space="preserve">
    <value>"&lt;press count&gt;|ok" or "&lt;press count&gt;|failed" once the action has answered.</value>
  </data>
  <data name="actionResult_Name" xml:space="preserve">
    <value>Action result</value>
  </data>
  <data name="actionResult_Desc" xml:space="preserve">
    <value>The result property's value from the last call, or empty.</value>
  </data>
  <data name="FormActionButton_Running" xml:space="preserve">
    <value>Running…</value>
  </data>
  <data name="FormActionButton_Sent" xml:space="preserve">
    <value>Sent.</value>
  </data>
  <data name="FormActionButton_SaveFirst" xml:space="preserve">
    <value>Save the record first.</value>
  </data>
  <data name="FormActionButton_NoOrganisation" xml:space="preserve">
    <value>This button calls a Dataverse action, and there is no Dataverse here to call.</value>
  </data>
  <data name="FormActionButton_NoAddress" xml:space="preserve">
    <value>The address of this table's records could not be read.</value>
  </data>
  <data name="FormActionButton_BadName" xml:space="preserve">
    <value>"{0}" is not an action name the Web API takes.</value>
  </data>
  <data name="FormActionButton_BadResult" xml:space="preserve">
    <value>"{0}" is not a response property name.</value>
  </data>
  <data name="FormActionButton_BadParameters" xml:space="preserve">
    <value>The action's parameters could not be read: {0}</value>
  </data>
  <data name="FormActionButton_ParametersMissing" xml:space="preserve">
    <value>The web resource {0}, which holds the action's parameters, was not found.</value>
  </data>
  <data name="FormActionButton_ParametersUnreadable" xml:space="preserve">
    <value>The web resource {0}, which holds the action's parameters, could not be read.</value>
  </data>
  <data name="FormActionButton_ActionNameHint" xml:space="preserve">
    <value>Check the action's name, {0}, and whether it is bound: names are case-sensitive.</value>
  </data>
</root>
