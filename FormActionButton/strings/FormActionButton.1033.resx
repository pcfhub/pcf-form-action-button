  <data name="FormActionButton_Name" xml:space="preserve">
    <value>Form Action Button</value>
  </data>
  <data name="FormActionButton_Desc" xml:space="preserve">
    <value>A model-driven form button that raises an event a form script can handle, confirm and answer.</value>
  </data>
  <data name="signal_Name" xml:space="preserve">
    <value>Signal column</value>
  </data>
  <data name="signal_Desc" xml:space="preserve">
    <value>The column the button sits on. Not written unless Write to the signal column is on.</value>
  </data>
  <data name="label_Name" xml:space="preserve">
    <value>Label</value>
  </data>
  <data name="label_Desc" xml:space="preserve">
    <value>The text on the button, which is also its accessible name.</value>
  </data>
  <data name="icon_Name" xml:space="preserve">
    <value>Icon</value>
  </data>
  <data name="icon_Desc" xml:space="preserve">
    <value>An optional glyph shown before the label.</value>
  </data>
  <data name="icon_None" xml:space="preserve">
    <value>None</value>
  </data>
  <data name="icon_Send" xml:space="preserve">
    <value>Send</value>
  </data>
  <data name="icon_Delete" xml:space="preserve">
    <value>Delete</value>
  </data>
  <data name="confirmRequired_Name" xml:space="preserve">
    <value>Confirm before acting</value>
  </data>
  <data name="confirmRequired_Desc" xml:space="preserve">
    <value>Ask the user to confirm before the event is raised.</value>
  </data>
  <data name="confirmTitle_Name" xml:space="preserve">
    <value>Confirmation title</value>
  </data>
  <data name="confirmTitle_Desc" xml:space="preserve">
    <value>The title of the confirmation dialog. Leave empty for a default.</value>
  </data>
  <data name="confirmText_Name" xml:space="preserve">
    <value>Confirmation message</value>
  </data>
  <data name="confirmText_Desc" xml:space="preserve">
    <value>The question the confirmation dialog asks. Leave empty for a default.</value>
  </data>
  <data name="confirmButtonLabel_Name" xml:space="preserve">
    <value>Confirmation button</value>
  </data>
  <data name="confirmButtonLabel_Desc" xml:space="preserve">
    <value>The affirmative word. Used in the dialog, and as the button’s caption while an inline confirmation is armed.</value>
  </data>
  <data name="writeSignal_Name" xml:space="preserve">
    <value>Write to the signal column</value>
  </data>
  <data name="writeSignal_Desc" xml:space="preserve">
    <value>Write each press into the bound column, so its own OnChange handler and business rules see it.</value>
  </data>
  <data name="requirePrivilege_Name" xml:space="preserve">
    <value>Require a privilege</value>
  </data>
  <data name="requirePrivilege_Desc" xml:space="preserve">
    <value>Check the user’s privilege on this table before letting the button be pressed.</value>
  </data>
  <data name="privilege_None" xml:space="preserve">
    <value>No check</value>
  </data>
  <data name="privilege_Create" xml:space="preserve">
    <value>Create</value>
  </data>
  <data name="privilege_Read" xml:space="preserve">
    <value>Read</value>
  </data>
  <data name="privilege_Write" xml:space="preserve">
    <value>Write</value>
  </data>
  <data name="privilege_Delete" xml:space="preserve">
    <value>Delete</value>
  </data>
  <data name="privilege_Append" xml:space="preserve">
    <value>Append</value>
  </data>
  <data name="privilege_AppendTo" xml:space="preserve">
    <value>Append to</value>
  </data>
  <data name="privilegeDenied_Name" xml:space="preserve">
    <value>When the privilege is missing</value>
  </data>
  <data name="privilegeDenied_Desc" xml:space="preserve">
    <value>Whether to disable the button or hide it entirely.</value>
  </data>
  <data name="denied_Disable" xml:space="preserve">
    <value>Disable it</value>
  </data>
  <data name="denied_Hide" xml:space="preserve">
    <value>Hide it</value>
  </data>
  <data name="pressCount_Name" xml:space="preserve">
    <value>Press count</value>
  </data>
  <data name="pressCount_Desc" xml:space="preserve">
    <value>How many times the button has raised its event. Increments on every raise, so a repeat is observable.</value>
  </data>
  <data name="lastAction_Name" xml:space="preserve">
    <value>Last action</value>
  </data>
  <data name="lastAction_Desc" xml:space="preserve">
    <value>Either "press" or "confirm", depending on whether the press was confirmed.</value>
  </data>
  <data name="onAction_Name" xml:space="preserve">
    <value>On action</value>
  </data>
  <data name="onAction_Desc" xml:space="preserve">
    <value>Raised when the button is pressed and any confirmation has been given. A form script binds to it with addEventHandler("onAction", fn).</value>
  </data>
  <data name="FormActionButton_DefaultLabel" xml:space="preserve">
    <value>Submit</value>
  </data>
  <data name="FormActionButton_ConfirmTitle" xml:space="preserve">
    <value>Confirm</value>
  </data>
  <data name="FormActionButton_ConfirmText" xml:space="preserve">
    <value>Are you sure?</value>
  </data>
  <data name="FormActionButton_ConfirmButton" xml:space="preserve">
    <value>Confirm</value>
  </data>
  <data name="FormActionButton_Armed" xml:space="preserve">
    <value>Press again to confirm, or press Escape to cancel.</value>
  </data>
  <data name="FormActionButton_Cancelled" xml:space="preserve">
    <value>Cancelled.</value>
  </data>
  <data name="FormActionButton_TimedOut" xml:space="preserve">
    <value>The confirmation expired.</value>
  </data>
  <data name="FormActionButton_Busy" xml:space="preserve">
    <value>Working…</value>
  </data>
  <data name="FormActionButton_Done" xml:space="preserve">
    <value>Done.</value>
  </data>
  <data name="FormActionButton_Failed" xml:space="preserve">
    <value>The action did not complete.</value>
  </data>
  <data name="FormActionButton_Stalled" xml:space="preserve">
    <value>The action never reported back, so the button was released.</value>
  </data>
  <data name="FormActionButton_NoPrivilege" xml:space="preserve">
    <value>You do not have permission to do this.</value>
  </data>
</root>
