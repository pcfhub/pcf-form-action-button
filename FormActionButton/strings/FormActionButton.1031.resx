  <data name="FormActionButton_Name" xml:space="preserve">
    <value>Formular-Aktionsschaltfläche</value>
  </data>
  <data name="FormActionButton_Desc" xml:space="preserve">
    <value>Eine Schaltfläche für modellgesteuerte Formulare, die ein Ereignis auslöst, das ein Formularskript behandeln, bestätigen und beantworten kann.</value>
  </data>
  <data name="signal_Name" xml:space="preserve">
    <value>Signalspalte</value>
  </data>
  <data name="signal_Desc" xml:space="preserve">
    <value>Die Spalte, auf der die Schaltfläche sitzt. Wird nur beschrieben, wenn In Signalspalte schreiben aktiviert ist.</value>
  </data>
  <data name="label_Name" xml:space="preserve">
    <value>Beschriftung</value>
  </data>
  <data name="label_Desc" xml:space="preserve">
    <value>Der Text auf der Schaltfläche, der zugleich ihr zugänglicher Name ist.</value>
  </data>
  <data name="icon_Name" xml:space="preserve">
    <value>Symbol</value>
  </data>
  <data name="icon_Desc" xml:space="preserve">
    <value>Ein optionales Zeichen vor der Beschriftung.</value>
  </data>
  <data name="icon_None" xml:space="preserve">
    <value>Keines</value>
  </data>
  <data name="icon_Send" xml:space="preserve">
    <value>Senden</value>
  </data>
  <data name="icon_Delete" xml:space="preserve">
    <value>Löschen</value>
  </data>
  <data name="confirmRequired_Name" xml:space="preserve">
    <value>Vor der Aktion bestätigen</value>
  </data>
  <data name="confirmRequired_Desc" xml:space="preserve">
    <value>Fragt den Benutzer, bevor das Ereignis ausgelöst wird.</value>
  </data>
  <data name="confirmTitle_Name" xml:space="preserve">
    <value>Titel der Bestätigung</value>
  </data>
  <data name="confirmTitle_Desc" xml:space="preserve">
    <value>Der Titel des Bestätigungsdialogs. Leer lassen für einen Standardwert.</value>
  </data>
  <data name="confirmText_Name" xml:space="preserve">
    <value>Bestätigungstext</value>
  </data>
  <data name="confirmText_Desc" xml:space="preserve">
    <value>Die Frage im Bestätigungsdialog. Leer lassen für einen Standardwert.</value>
  </data>
  <data name="confirmButtonLabel_Name" xml:space="preserve">
    <value>Bestätigungsschaltfläche</value>
  </data>
  <data name="confirmButtonLabel_Desc" xml:space="preserve">
    <value>Das bestätigende Wort. Wird im Dialog verwendet und als Beschriftung, solange eine Inline-Bestätigung aktiv ist.</value>
  </data>
  <data name="writeSignal_Name" xml:space="preserve">
    <value>In Signalspalte schreiben</value>
  </data>
  <data name="writeSignal_Desc" xml:space="preserve">
    <value>Schreibt jeden Tastendruck in die gebundene Spalte, damit deren OnChange-Handler und Geschäftsregeln ihn sehen.</value>
  </data>
  <data name="requirePrivilege_Name" xml:space="preserve">
    <value>Berechtigung verlangen</value>
  </data>
  <data name="requirePrivilege_Desc" xml:space="preserve">
