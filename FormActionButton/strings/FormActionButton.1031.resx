  </data>
  <data name="lastAction_Name" xml:space="preserve">
    <value>Letzte Aktion</value>
  </data>
  <data name="lastAction_Desc" xml:space="preserve">
    <value>Entweder „press“ oder „confirm“, je nachdem, ob der Klick bestätigt wurde.</value>
  </data>
  <data name="onAction_Name" xml:space="preserve">
    <value>Bei Aktion</value>
  </data>
  <data name="onAction_Desc" xml:space="preserve">
    <value>Wird ausgelöst, wenn die Schaltfläche gedrückt und eine etwaige Bestätigung erteilt wurde. Ein Formularskript bindet sich mit addEventHandler("onAction", fn).</value>
  </data>
